generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String              @id @default(uuid())
  email             String              @unique
  password          String              // Hashed password
  name              String
  phone             String?             // For SMS notifications
  role              UserRole 
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  projectProposals  ProjectProposal[]   // Back relation: proposals posted by this user
  @@map("users")
}

model Notification {
  id            String   @id @default(uuid())
  phone         String   // Recipient phone number
  message       String   @db.Text
  status        String   // Delivery status
  sentAt        DateTime @default(now())
  bookingNumber String?  // Optional reference to booking
  @@map("notifications")
}

model ProjectProposal {
  id           String                   @id @default(uuid())
  title        String
  description  String
  status       ProjectProposalStatus
  proposedDate DateTime                 @default(now())
  approvedby   Json?
  postedById   String
  postedBy     User     @relation(fields: [postedById], references: [id])
  @@map("project_proposals")
}

enum ProjectProposalStatus {
  pending
  approved
  urgent
  rejected
}

enum UserRole {
  Admin
  Education
  Environment
  Finance
  HealthServices
  PeaceOrder
  PublicWorks
  Woomen
}
