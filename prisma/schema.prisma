generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String              @id
  email             String              @unique
  password          String              // Hashed password
  name              String
  phone             String?             // For SMS notifications
  role              UserRole 
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  projectProposals  ProjectProposal[]   // Proposals posted by this user
  approvedBy        ApprovedBy[]        // Approvals done by this user
  votes             Vote[]
  @@map("users")
}

model Notification {
  id            String   @id @default(uuid())
  phone         String   // Recipient phone number
  message       String   @db.Text
  status        String   // Delivery status
  sentAt        DateTime @default(now())
  bookingNumber String?  // Optional reference to booking
  @@map("notifications")
}

model ProjectProposal {
  id           String                   @id @default(uuid())
  title        String
  description  String
  proposedDate DateTime                 @default(now())
  fileUrl      String
  postedById   String
  budget       Float                    // new budget field
  postedBy     User                     @relation(fields: [postedById], references: [id], onDelete: Cascade)
  approvedBy   ApprovedBy[]             // Relation to approvals
  votes        Vote[]
  
  @@map("projectProposals")
}

model Vote {
  id         String          @id @default(uuid())
  userId     String
  proposalId String
  vote       VoteStatus         // For example: true for 'yes' and false for 'no'
  votedAt    DateTime        @default(now())
  comment    String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  proposal   ProjectProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([userId, proposalId])
}

model ApprovedBy {
  id          String            @id @default(uuid())
  updatedAt    DateTime        @default(now())
  userId      String            // This must be required if approval is mandatory
  status      ApprovedStatus
  comment     String?
  proposalId  String            // ID of the project proposal being approved
  approvedBy  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  proposal    ProjectProposal   @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  @@unique([userId, proposalId], name: "userId_proposalId")
  @@map("approved_by")
}

enum ApprovedStatus {
  Pending
  Approved
  Rejected
}

enum VoteStatus {
  Approved
  Rejected
}

enum UserRole {
  Admin
  Education
  Environment
  Finance
  HealthServices
  PeaceOrder
  PublicWorks
  Women
}
